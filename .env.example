# Firebase Configuration (Client-Safe Values)
# Get these from your Firebase Console project settings
# https://console.firebase.google.com/
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_FIRESTORE_DB_ID=your-firestore-database-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Gemini API Configuration (Server-side only)
# Set this only on your backend/server environment
GEMINI_API_KEY=your-gemini-api-key

# Application URL
# Used for OAuth callbacks and self-referential links
APP_URL=http://localhost:5173

# Twilio Configuration (Server-side only)
# Set these only on your backend/server environment
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
TWILIO_PHONE_NUMBER=+15551234567

# Department Forwarding Phone Numbers (E.164 format)
OPERATOR_FORWARDING_PHONE=+15550001111
DISPATCH_FORWARDING_PHONE=+15550002222
EMERGENCY_FORWARDING_PHONE=+15550003333
BILLING_FORWARDING_PHONE=+15550004444
SALES_FORWARDING_PHONE=+15550005555
