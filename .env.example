# ==============================================================================
# RCOS Mobile App — Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env or .env.local for local development.
# NEVER commit real credentials, private keys, or tokens to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER RUNTIME (Backend Only - Secret)
# ------------------------------------------------------------------------------
PORT=3000
NODE_ENV=production

# Base Public URL where the Express API is hosted (e.g. Cloud Run, Railway, Render)
# Required for Twilio PSTN webhooks and Android native HTTPS requests
APP_URL=https://rcos-mobile-app-production.up.railway.app

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Backend Only - Secret)
# Obtained from: Google AI Studio (https://aistudio.google.com/apikey)
# NOTE: Never prefix with VITE_. The frontend never accesses this key directly.
# ------------------------------------------------------------------------------
GEMINI_API_KEY=

# ------------------------------------------------------------------------------
# 3. TWILIO TELEPHONY / CARRIER INTEGRATION (Backend Only - Secret)
# Obtained from: Twilio Console (https://console.twilio.com)
# ------------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Department Forwarding Phone Numbers (Real PSTN Lines)
OPERATOR_FORWARDING_PHONE=+15550194820
DISPATCH_FORWARDING_PHONE=+15553928811
BILLING_FORWARDING_PHONE=+15557412290
EMERGENCY_FORWARDING_PHONE=+15558831120
SALES_FORWARDING_PHONE=+15556124490
SUPPORT_FORWARDING_PHONE=+15559023310

# ------------------------------------------------------------------------------
# 4. FIREBASE CLIENT CONFIGURATION (Client & Backend - Public)
# Obtained from: Firebase Console > Project Settings > General > Your Apps
# ------------------------------------------------------------------------------
VITE_FIREBASE_PROJECT_ID=rcos-mobile
VITE_FIREBASE_APP_ID=1:627752468605:web:f9ea1940489bfda9e07114
VITE_FIREBASE_API_KEY=AIzaSyDBFhrYAsHNOCfBZkL4uVNMLk06BsUEjgQ
VITE_FIREBASE_AUTH_DOMAIN=rcos-mobile.firebaseapp.com
VITE_FIREBASE_DATABASE_ID=ai-studio-rcosmobileapp-c0c46f2b-8d0f-43b8-978d-70fb08614967
VITE_FIREBASE_STORAGE_BUCKET=rcos-mobile.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=627752468605

# ------------------------------------------------------------------------------
# 5. CLIENT API ROUTING
# In Web Browser dev, leave empty (uses relative proxy routes)
# In native Android APK, defaults to APP_URL over HTTPS
# ------------------------------------------------------------------------------
VITE_API_URL=

# ------------------------------------------------------------------------------
# 6. API LOGIN GATE (Backend Only - Secret)
# Service-account JSON for the rcos-mobile Firebase project.
# Firebase console > Project settings > Service accounts > Generate new private key.
# Paste the ENTIRE JSON on one line. Until this is set, /api routes stay open.
# ------------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT=

# ------------------------------------------------------------------------------
# 7. TELEPHONY PROVIDER (Backend)
# 'twilio' = real phone carrier. Anything else (e.g. 'webrtc') parks Twilio and
# uses the in-app WebRTC voice call instead. Testing/review builds: leave as webrtc.
# ------------------------------------------------------------------------------
TELEPHONY_PROVIDER=webrtc

# ------------------------------------------------------------------------------
# 8. WEBRTC VOICE CALLING (Backend Only - Secret, except URL)
# LiveKit Cloud free tier works for testing: https://cloud.livekit.io
# ------------------------------------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Shared secret the voice-agent worker uses to log routing decisions
VOICE_AGENT_SECRET=
