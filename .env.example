# ==============================================================================
# RCOS Mobile App - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit .env.local or production secrets to source control.
# ==============================================================================

# Server Configuration
PORT=3000
NODE_ENV=development

# Gemini AI / LLM Configuration (Server-Side Proxy)
GEMINI_API_KEY=your_gemini_key_here

# Client Firebase Configuration (Vite environment variables prefixed with VITE_)
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890
VITE_FIREBASE_DATABASE_ID=your_firestore_database_id
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
VITE_FIREBASE_RECAPTCHA_SITE_KEY=

# Authentication Security Controls
# Set to 'true' ONLY in offline/local testing to reveal developer seed shortcuts.
# In production, set to 'false' to enforce strict Firebase & Google OAuth credentials.
VITE_ENABLE_DEMO_AUTH=false
