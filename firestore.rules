rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Connection test document for startup latency check
    match /test/connection {
      allow read: if true;
    }

    // Businesses Collection - Tenant Data & Subcollections
    match /businesses/{businessId} {
      allow read, write: if isValidId(businessId);

      // Subcollection: Requests (Intake Pipeline)
      match /requests/{requestId} {
        allow read, write: if isValidId(businessId);
      }

      // Subcollection: Actions & Approvals
      match /actions/{actionId} {
        allow read, write: if isValidId(businessId);
      }

      // Subcollection: Jobs (Field Dispatch)
      match /jobs/{jobId} {
        allow read, write: if isValidId(businessId);
      }

      // Subcollection: Customers / Clients (CRM)
      match /customers/{customerId} {
        allow read, write: if isValidId(businessId);
      }

      // Subcollection: Chat Messages
      match /chatMessages/{messageId} {
        allow read, write: if isValidId(businessId);
      }

      // Subcollection: Audit Logs
      match /auditLogs/{logId} {
        allow read, write: if isValidId(businessId);
      }

      // Any nested subcollections under business
      match /{allSubcollections=**} {
        allow read, write: if isValidId(businessId);
      }
    }

    // Job Packs global templates
    match /jobPacks/{jobPackId} {
      allow read, write: if true;
    }
  }
}
